# Copy this file to ".env" and put your own MySQL details here
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stockly

# --- Cloud database (e.g. TiDB Cloud) ---
# For a cloud database use a separate file called ".env.cloud" with the same names, plus:
#   DB_SSL=true
# (cloud databases only accept encrypted connections)
DB_SSL=false
